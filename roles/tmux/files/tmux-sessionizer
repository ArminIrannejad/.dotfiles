#!/usr/bin/env bash

switch_to() {
    if [[ -z $TMUX ]]; then
        tmux attach-session -t $1
    else
        tmux switch-client -t $1
    fi
}

has_session() {
    tmux list-sessions | grep -q "^$1:"
}

hydrate() {
    if [ -f $2/.tmux-sessionizer ]; then
        tmux send-keys -t $1 "source $2/.tmux-sessionizer" c-M
    elif [ -f $HOME/.tmux-sessionizer ]; then
        tmux send-keys -t $1 "source $HOME/.tmux-sessionizer" c-M
    fi
}

die() {
    if [[ -n $TMUX ]]; then
        tmux display-message "$1"
    else
        echo "$1" >&2
    fi
    exit 1
}

# Pick a branch of the repo at $1; worktrees live in ~/.worktrees/<repo>/<branch>, ctrl-x removes one.
worktree() {
    local common main repo out query key line branch path err
    common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
        die "Not a git repo: $1"
    main=$(dirname "$common")
    repo=$(basename "$main")

    local log="git -C '$main' log --oneline --color=always -15"
    local preview="if [ -n {2} ]; then git -C {2} -c color.status=always status -sb; echo; git -C {2} log --oneline --color=always -15
        else $log {1} -- 2>/dev/null || $log --remotes='*/'{1}; fi"

    # Worktrees (green) first, then branches by last commit, remote only ones dimmed.
    mapfile -t out < <(
        {
            # Main repo stays listed when detached, e.g. mid rebase.
            git -C "$main" worktree list --porcelain | awk '
                /^worktree /          { p = substr($0, 10); n++ }
                /^branch /            { sub("refs/heads/", "", $2); printf "\033[32m%s\033[0m\t%s\n", $2, p }
                /^detached/ && n == 1 { printf "\033[32m(detached)\033[0m\t%s\n", p }'
            git -C "$main" for-each-ref --sort=-committerdate --format='%(refname:lstrip=2)' refs/heads
            git -C "$main" for-each-ref --sort=-committerdate --format='%(refname:lstrip=3)' refs/remotes |
                grep -vx HEAD | awk '{ printf "\033[2m%s\033[0m\n", $0 }'
        } | awk -F'\t' '{ k = $1; gsub(/\033\[[0-9;]*m/, "", k) } !seen[k]++' |
            fzf --ansi --delimiter='\t' --with-nth=1 --print-query --expect=ctrl-x \
                --border-label=" $repo " --header="ctrl-x: remove worktree" --preview="$preview"
    )

    query=${out[0]} key=${out[1]} line=${out[2]}
    branch=${line%%$'\t'*}
    path=
    [[ $line == *$'\t'* ]] && path=${line#*$'\t'}

    if [[ -z $line ]]; then
        [[ -z $query ]] && exit 0
        branch=$query
    fi

    name=${repo}_${branch}

    if [[ $key == ctrl-x ]]; then
        [[ -n $path && $path != "$main" ]] || die "Not a removable worktree: $branch"
        err=$(git -C "$main" worktree remove "$path" 2>&1) || die "$err"
        tmux kill-session -t "=$(echo "$name" | sed 's/^\.//' | tr ./: _)" 2>/dev/null
        exit 0
    fi

    if [[ $path == "$main" ]]; then
        selected=$main name=
        return
    fi

    if [[ -z $path ]]; then
        path=$HOME/.worktrees/${repo#.}/$branch
        if [[ -n $line ]]; then
            err=$(git -C "$main" worktree add "$path" "$branch" 2>&1) || die "$err"
        else
            err=$(git -C "$main" worktree add -b "$branch" "$path" 2>&1) || die "$err"
        fi
    fi

    selected=$path
}

name=
if [[ $1 == -w ]]; then
    worktree "${2:-$PWD}"
elif [[ $# -eq 1 ]]; then
    selected=$1
else
    # Dirs with a running session in green.
    open=$(tmux list-sessions -F '#{session_path}' 2>/dev/null)
    selected=$(find ~/.dotfiles ~/personal/* ~/work/* -maxdepth 0 -type d |
        awk -v open="$open" 'BEGIN { split(open, o, "\n"); for (i in o) s[o[i]] }
            $0 in s { sub(/[^\/]*$/, "\033[32m&\033[0m") } 1' |
        fzf --ansi --delimiter=/ --with-nth=-1 \
            --preview='git -C {} log --oneline --color=always -15 2>/dev/null || ls -A {}')
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(echo "${name:-$(basename "$selected")}" | sed 's/^\.//' | tr ./: _)

# .foo and foo strip to the same name; keep the dot for whichever loses the race.
if has_session "$selected_name" &&
   [[ $(tmux display-message -p -t "$selected_name" '#{session_path}') != "$selected" ]]; then
    selected_name="_$selected_name"
fi

tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    hydrate $selected_name $selected
    exit 0
fi

if ! has_session $selected_name; then
    tmux new-session -ds $selected_name -c $selected
    hydrate $selected_name $selected
fi

switch_to $selected_name
