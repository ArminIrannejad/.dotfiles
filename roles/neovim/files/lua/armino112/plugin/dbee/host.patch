--- a/core/builders/next_abandon_test.go
+++ b/core/builders/next_abandon_test.go
@@ -0,0 +1,35 @@
+package builders
+
+import (
+	"testing"
+	"time"
+)
+
+// a capped drain stops calling hasNext mid-stream, so the yield goroutine must
+// give up on its own rather than sit on a full channel forever.
+func TestNextYieldAbandonsUnreadRows(t *testing.T) {
+	abandonAfter = 50 * time.Millisecond
+	defer func() { abandonAfter = 60 * time.Second }()
+
+	returned := make(chan struct{})
+	_, hasNext := NextYield(func(yield func(...any)) error {
+		defer close(returned)
+		for i := 0; i < 1000; i++ {
+			yield(i)
+		}
+		return nil
+	})
+
+	// read a few rows, then walk away like a capped drain does
+	for i := 0; i < 5; i++ {
+		if !hasNext() {
+			t.Fatal("stream ended early")
+		}
+	}
+
+	select {
+	case <-returned:
+	case <-time.After(10 * time.Second):
+		t.Fatal("yield goroutine never returned: a capped drain leaks it")
+	}
+}
