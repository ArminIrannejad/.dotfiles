diff -ruN a/core/limit.go b/core/limit.go
--- a/core/limit.go
+++ b/core/limit.go
@@ -0,0 +1,29 @@
+package core
+
+import (
+	"os"
+	"regexp"
+	"strconv"
+)
+
+// the host drains a whole result set into memory before the ui draws its first
+// page, and never evicts it. DBEE_MAX_ROWS bounds the drain instead of the
+// query: past the cap the iterator is closed and the rest is never read.
+// a query carrying `no_limit` opts out. 0 or unset means no cap.
+var maxRows = func() int {
+	n, err := strconv.Atoi(os.Getenv("DBEE_MAX_ROWS"))
+	if err != nil || n < 0 {
+		return 0
+	}
+	return n
+}()
+
+var noLimitRe = regexp.MustCompile(`(?i)\bno_limit\b`)
+
+// rowCap is the cap that applies to a query, 0 for none.
+func rowCap(query string) int {
+	if noLimitRe.MatchString(query) {
+		return 0
+	}
+	return maxRows
+}
diff -ruN a/core/limit_internal_test.go b/core/limit_internal_test.go
--- a/core/limit_internal_test.go
+++ b/core/limit_internal_test.go
@@ -0,0 +1,51 @@
+package core
+
+import "testing"
+
+type countStream struct {
+	n, read int
+	closed  bool
+}
+
+func (s *countStream) Meta() *Meta    { return &Meta{} }
+func (s *countStream) Header() Header { return Header{"a"} }
+func (s *countStream) HasNext() bool  { return s.read < s.n }
+func (s *countStream) Close()         { s.closed = true }
+func (s *countStream) Next() (Row, error) {
+	s.read++
+	return Row{s.read}, nil
+}
+
+func TestRowCap(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		cap   int
+		query string
+		want  int
+		read  int
+	}{
+		{"capped", 10, "select * from t", 10, 10},
+		{"under cap", 5000, "select * from t", 1000, 1000},
+		{"no cap", 0, "select * from t", 1000, 1000},
+		{"opt out", 10, "select * from t -- no_limit", 1000, 1000},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			maxRows = tc.cap
+			s := &countStream{n: 1000}
+			r := new(Result)
+			r.maxRows = rowCap(tc.query)
+			if err := r.SetIter(s, nil); err != nil {
+				t.Fatal(err)
+			}
+			if r.Len() != tc.want {
+				t.Fatalf("kept %d rows, want %d", r.Len(), tc.want)
+			}
+			if s.read != tc.read {
+				t.Fatalf("pulled %d rows from the driver, want %d", s.read, tc.read)
+			}
+			if !s.closed {
+				t.Fatal("iterator not closed")
+			}
+		})
+	}
+}
