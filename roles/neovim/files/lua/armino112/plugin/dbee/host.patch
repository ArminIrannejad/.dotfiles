diff --git a/core/limit.go b/core/limit.go
new file mode 100644
index 0000000..43eea5d
--- /dev/null
+++ b/core/limit.go
@@ -0,0 +1,112 @@
+package core
+
+import (
+	"os"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// the host drains a whole result set into memory before the ui draws its first
+// page, and never evicts it. DBEE_MAX_MEMORY bounds the drain instead of the
+// query: once the rows held pass the budget the iterator is closed and the rest
+// is never read. it takes bytes or a size like 512MiB or 2G, 0 or off for none.
+// a query carrying `no_limit` opts out.
+const defaultMaxMemory = 1 << 30
+
+var maxMemory = parseSize(os.Getenv("DBEE_MAX_MEMORY"), defaultMaxMemory)
+
+var sizeRe = regexp.MustCompile(`(?i)^\s*(\d+(?:\.\d+)?)\s*([kmgt]?)(?:i?b)?\s*$`)
+
+// parseSize reads a byte count with an optional binary unit, fallback if unset or garbled.
+func parseSize(s string, fallback int64) int64 {
+	if strings.EqualFold(strings.TrimSpace(s), "off") {
+		return 0
+	}
+	m := sizeRe.FindStringSubmatch(s)
+	if m == nil {
+		return fallback
+	}
+	n, err := strconv.ParseFloat(m[1], 64)
+	if err != nil {
+		return fallback
+	}
+	shift := 0
+	if m[2] != "" {
+		shift = strings.Index("kmgt", strings.ToLower(m[2])) + 1
+	}
+	return int64(n * float64(int64(1)<<(10*shift)))
+}
+
+var noLimitRe = regexp.MustCompile(`(?i)\bno_limit\b`)
+
+// memoryCap is the budget that applies to a query, 0 for none.
+func memoryCap(query string) int64 {
+	if noLimitRe.MatchString(query) {
+		return 0
+	}
+	return maxMemory
+}
+
+// rowSize roughly estimates the bytes a row keeps alive: the slice, an interface
+// per cell and whatever each cell points at.
+func rowSize(row Row) int64 {
+	n := int64(24 + 16*len(row))
+	for _, v := range row {
+		n += valueSize(reflect.ValueOf(v), 0)
+	}
+	return n
+}
+
+var timeType = reflect.TypeOf(time.Time{})
+
+// valueSize is the heap behind v. depth bounds the walk for nested driver types.
+func valueSize(v reflect.Value, depth int) int64 {
+	if !v.IsValid() || depth > 8 {
+		return 0
+	}
+	switch v.Kind() {
+	case reflect.String:
+		return int64(v.Len())
+	case reflect.Slice:
+		if v.Type().Elem().Kind() == reflect.Uint8 {
+			return int64(v.Len())
+		}
+		n := int64(v.Len()) * int64(v.Type().Elem().Size())
+		for i := 0; i < v.Len(); i++ {
+			n += valueSize(v.Index(i), depth+1)
+		}
+		return n
+	case reflect.Map:
+		n := int64(v.Len()) * int64(v.Type().Key().Size()+v.Type().Elem().Size())
+		iter := v.MapRange()
+		for iter.Next() {
+			n += valueSize(iter.Key(), depth+1) + valueSize(iter.Value(), depth+1)
+		}
+		return n
+	case reflect.Pointer, reflect.Interface:
+		if v.IsNil() {
+			return 0
+		}
+		e := v.Elem()
+		return int64(e.Type().Size()) + valueSize(e, depth+1)
+	case reflect.Struct:
+		if v.Type() == timeType {
+			return 0
+		}
+		var n int64
+		for i := 0; i < v.NumField(); i++ {
+			n += valueSize(v.Field(i), depth+1)
+		}
+		return n
+	case reflect.Array:
+		var n int64
+		for i := 0; i < v.Len(); i++ {
+			n += valueSize(v.Index(i), depth+1)
+		}
+		return n
+	}
+	return 0
+}
diff --git a/core/limit_internal_test.go b/core/limit_internal_test.go
new file mode 100644
index 0000000..d29be2a
--- /dev/null
+++ b/core/limit_internal_test.go
@@ -0,0 +1,88 @@
+package core
+
+import (
+	"strings"
+	"testing"
+)
+
+type countStream struct {
+	n, read int
+	closed  bool
+}
+
+func (s *countStream) Meta() *Meta    { return &Meta{} }
+func (s *countStream) Header() Header { return Header{"a"} }
+func (s *countStream) HasNext() bool  { return s.read < s.n }
+func (s *countStream) Close()         { s.closed = true }
+func (s *countStream) Next() (Row, error) {
+	s.read++
+	return Row{s.read}, nil
+}
+
+func TestMemoryCap(t *testing.T) {
+	// every countStream row is an int in a one cell row
+	row := rowSize(Row{1})
+
+	for _, tc := range []struct {
+		name  string
+		cap   int64
+		query string
+		want  int
+	}{
+		{"capped", 10 * row, "select * from t", 10},
+		{"under cap", 5000 * row, "select * from t", 1000},
+		{"no cap", 0, "select * from t", 1000},
+		{"opt out", 10 * row, "select * from t -- no_limit", 1000},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			maxMemory = tc.cap
+			defer func() { maxMemory = defaultMaxMemory }()
+
+			s := &countStream{n: 1000}
+			r := new(Result)
+			r.maxMemory = memoryCap(tc.query)
+			if err := r.SetIter(s, nil); err != nil {
+				t.Fatal(err)
+			}
+			if r.Len() != tc.want {
+				t.Fatalf("kept %d rows, want %d", r.Len(), tc.want)
+			}
+			if s.read != tc.want {
+				t.Fatalf("pulled %d rows from the driver, want %d", s.read, tc.want)
+			}
+			if !s.closed {
+				t.Fatal("iterator not closed")
+			}
+		})
+	}
+}
+
+func TestParseSize(t *testing.T) {
+	for in, want := range map[string]int64{
+		"":        defaultMaxMemory,
+		"garbage": defaultMaxMemory,
+		"0":       0,
+		"off":     0,
+		"2048":    2048,
+		"512MiB":  512 << 20,
+		"1GiB":    1 << 30,
+		"1.5g":    3 << 29,
+		"2 GB":    2 << 30,
+		"64k":     64 << 10,
+	} {
+		if got := parseSize(in, defaultMaxMemory); got != want {
+			t.Errorf("parseSize(%q) = %d, want %d", in, got, want)
+		}
+	}
+}
+
+func TestRowSize(t *testing.T) {
+	small := rowSize(Row{1, "a"})
+	big := rowSize(Row{1, strings.Repeat("a", 1<<20)})
+	if big-small < 1<<20-1 {
+		t.Fatalf("a 1MiB string only added %d bytes", big-small)
+	}
+	if nested := rowSize(Row{map[string]any{"k": []byte(strings.Repeat("b", 4096))}}); nested < 4096 {
+		t.Fatalf("nested value sized at %d, want at least 4096", nested)
+	}
+}
